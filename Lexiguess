/* =========================================================
   GAME VARIABLES
   ========================================================= */

var currentLevel = "";
var currentIdx = 0;
var totalScore = 0;
var levelScore = 0;


/* =========================================================
   START LEVEL
   ========================================================= */

function startLevel(level) {

  currentLevel = level;
  currentIdx = 0;
  levelScore = 0;

  document.getElementById("level-stage")
    .classList.add("hidden");

  document.getElementById("result-stage")
    .classList.add("hidden");

  document.getElementById("game-stage")
    .classList.remove("hidden");

  renderQuestion();
}


/* =========================================================
   RENDER QUESTION
   ========================================================= */

function renderQuestion() {

  var level = gameData[currentLevel];
  var q = level.questions[currentIdx];

  var badge =
    '<span class="level-badge ' +
    level.className +
    '">' +
    level.title +
    "</span>";

  document.getElementById("level-badge").innerHTML = badge;

  document.getElementById("question-number").innerText =
    "Question " +
    (currentIdx + 1) +
    " of " +
    level.questions.length;

  var progress =
    (currentIdx / level.questions.length) * 100;

  document.getElementById("progress-bar").style.width =
    progress + "%";

  document.getElementById("explanation-box")
    .style.display = "none";

  document.getElementById("next-btn")
    .classList.add("hidden");

  if (q.type === "multiple") {
    renderMultipleChoice(q);
  } else {
    renderFillExercise(q);
  }
}


/* =========================================================
   MULTIPLE CHOICE
   ========================================================= */

function renderMultipleChoice(q) {

  document.getElementById("scenario-box").innerHTML =
    "<strong>Base Concept: " +
    q.baseWord +
    "</strong><br><br>" +
    q.scenario;

  var html = "";

  for (var i = 0; i < q.choices.length; i++) {

    html +=
      '<button class="btn" id="btn-' +
      i +
      '" onclick="checkMultipleAnswer(' +
      i +
      ')">' +
      String.fromCharCode(65 + i) +
      ". " +
      q.choices[i].word +
      "</button>";
  }

  document.getElementById("choices-box").innerHTML =
    html;

  document.getElementById("fill-box").innerHTML =
    "";
}


/* =========================================================
   CHECK MULTIPLE CHOICE
   ========================================================= */

function checkMultipleAnswer(selectedIndex) {

  var q =
    gameData[currentLevel].questions[currentIdx];

  for (var i = 0; i < q.choices.length; i++) {

    var btn =
      document.getElementById("btn-" + i);

    btn.disabled = true;

    if (q.choices[i].correct) {

      btn.className =
        "btn correct";

    } else if (i === selectedIndex) {

      btn.className =
        "btn wrong";
    }
  }

  if (q.choices[selectedIndex].correct) {
    addScore(100);
  }

  var expHtml = "";

  for (var j = 0; j < q.choices.length; j++) {

    var mark =
      q.choices[j].correct
        ? " ✅ Correct Answer"
        : " ❌";

    expHtml +=
      '<div class="exp-item">' +
      "<strong>" +
      q.choices[j].word +
      mark +
      "</strong><br>" +
      q.choices[j].explanation +
      "</div>";
  }

  showExplanation(expHtml);
}


/* =========================================================
   FILL-IN-THE-BLANK
   ========================================================= */

function renderFillExercise(q) {

  document.getElementById("scenario-box").innerHTML =
    "<strong>" +
    q.title +
    "</strong><br><br>" +
    q.scenario;

  document.getElementById("choices-box").innerHTML =
    "";

  var wordsHtml =
    '<div class="word-bank">' +
    "<strong>Word Bank:</strong><br>";

  for (var w = 0; w < q.words.length; w++) {

    wordsHtml +=
      '<span class="word">' +
      q.words[w] +
      "</span>";
  }

  wordsHtml += "</div>";

  var passageHtml =
    '<div class="blank-question">' +
    q.passage.replace(
      /\(([1-5])\)\s*______?/g,
      function(match, number) {

        return (
          "<strong>(" +
          number +
          ")</strong> " +

          '<input class="fill-input" ' +
          'id="fill-' +
          number +
          '" ' +
          'placeholder="Enter your answer">'
        );
      }
    ) +
    "</div>";

  var submitButton =
    '<button class="next-btn" ' +
    'style="display:block;" ' +
    'onclick="checkFillAnswers()">' +
    "Check Answers ✓" +
    "</button>";

  document.getElementById("fill-box").innerHTML =
    wordsHtml +
    passageHtml +
    submitButton;
}


/* =========================================================
   CHECK FILL-IN ANSWERS
   ========================================================= */

function checkFillAnswers() {

  var q =
    gameData[currentLevel].questions[currentIdx];

  var correctCount = 0;
  var expHtml = "";

  for (var i = 0; i < q.answers.length; i++) {

    var input =
      document.getElementById("fill-" + (i + 1));

    var userAnswer =
      input.value.trim().toLowerCase();

    var correctAnswer =
      q.answers[i].toLowerCase();

    if (userAnswer === correctAnswer) {

      correctCount++;

      input.style.borderColor =
        "#2d6a4f";

      input.style.background =
        "#1b4332";

    } else {

      input.style.borderColor =
        "#800f2f";

      input.style.background =
        "#4a0e17";
    }

    input.disabled = true;

    expHtml +=
      '<div class="exp-item">' +
      "<strong>Blank " +
      (i + 1) +
      ":</strong> " +

      (
        userAnswer === correctAnswer
          ? " ✅ Correct"
          : " ❌ Correct answer: " +
            q.answers[i]
      ) +

      "</div>";
  }

  addScore(correctCount * 20);

  showExplanation(expHtml);

  var submitButtons =
    document.querySelectorAll(
      "#fill-box .next-btn"
    );

  if (submitButtons.length > 0) {
    submitButtons[0].style.display =
      "none";
  }
}


/* =========================================================
   SCORE
   ========================================================= */

function addScore(points) {

  totalScore += points;
  levelScore += points;

  document.getElementById("score").innerText =
    "Score: " + totalScore + " XP";
}


/* =========================================================
   SHOW EXPLANATION
   ========================================================= */

function showExplanation(html) {

  document.getElementById("exp-content").innerHTML =
    html;

  document.getElementById("explanation-box")
    .style.display = "block";

  document.getElementById("next-btn")
    .classList.remove("hidden");

  if (
    currentIdx ===
    gameData[currentLevel].questions.length - 1
  ) {

    document.getElementById("next-btn").innerText =
      "Finish Level 🎉";

  } else {

    document.getElementById("next-btn").innerText =
      "Next Question →";
  }
}


/* =========================================================
   NEXT QUESTION
   ========================================================= */

function nextQuestion() {

  currentIdx++;

  if (
    currentIdx <
    gameData[currentLevel].questions.length
  ) {

    renderQuestion();

  } else {

    showResults();
  }
}


/* =========================================================
   SHOW RESULTS
   ========================================================= */

function showResults() {

  document.getElementById("game-stage")
    .classList.add("hidden");

  document.getElementById("result-stage")
    .classList.remove("hidden");

  var level =
    gameData[currentLevel];

  document.getElementById("final-score").innerText =
    levelScore + " XP";

  document.getElementById("result-message").innerText =
    "You completed the " +
    level.title +
    "! Your total game score is " +
    totalScore +
    " XP.";
}


/* =========================================================
   RESTART SAME LEVEL
   ========================================================= */

function restartGame() {

  currentIdx = 0;
  levelScore = 0;

  document.getElementById("game-stage")
    .classList.remove("hidden");

  document.getElementById("result-stage")
    .classList.add("hidden");

  renderQuestion();
}


/* =========================================================
   CHOOSE ANOTHER LEVEL
   ========================================================= */

function chooseLevel() {

  document.getElementById("result-stage")
    .classList.add("hidden");

  document.getElementById("game-stage")
    .classList.add("hidden");

  document.getElementById("level-stage")
    .classList.remove("hidden");
}

</script>

